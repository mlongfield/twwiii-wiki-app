---
import EntityLink from "./EntityLink.astro";

interface Props {
  links: ({ type: string; key: string; name: string | null; missing: boolean } | null)[];
}

const links = Astro.props.links.filter((l) => l !== null);
---
{links.length > 0 && (
  <ul class="link-list">
    {links.map((link) => <li><EntityLink link={link} /></li>)}
  </ul>
)}
